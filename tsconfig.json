{
  "//": "The options every frontend compiles with: apps/overleaf/tsconfig.json and apps/vscode/tsconfig.json extend these.",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker.ImportScripts"],
    "strict": true,
    "noImplicitAny": false,
    "rewriteRelativeImportExtensions": true,
    "allowImportingTsExtensions": false,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true
  },
  "files": []
}
