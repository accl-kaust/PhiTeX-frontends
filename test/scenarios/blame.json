{ "project": "test/scenarios/blame", "name": "blame", "strict": true, "history": "test/scenarios/blame-history.json",
  "storage": { "tipsSeen": ["compare", "timing", "clean", "dark", "blame"] },
  "steps": [
    { "type": " A sentence typed, not saved to the history yet.", "after": "architectural features are.", "keys": 0 },
    { "onpage": "not saved to the history", "ms": 60000 }, { "idle": 1500 },
    { "check": "!!document.getElementById('phitex-blame')", "page": true, "what": "the Blame toggle in Overleaf's toolbar, beside Compare" },
    { "click": "#phitex-blame", "ms": 2500 },
    { "check": "document.getElementById('phitex-blame').getAttribute('aria-pressed')", "page": true, "is": "true", "what": "the toggle pressed" },
    { "check": "document.querySelector('phitex-preview').shadowRoot.querySelectorAll('.slot .bl-bar').length > 8", "page": true, "what": "bars in the margin, a printed line each" },
    { "check": "document.querySelector('phitex-preview').shadowRoot.querySelectorAll('.slot .bl-bar.bl-hatch').length >= 1", "page": true, "what": "the edits not in the history yet hatched" },
    { "check": "[...document.querySelector('phitex-preview').shadowRoot.querySelectorAll('.blamebar .lg span:nth-child(2)')].map((e) => e.textContent).join('|')", "page": true, "is": "Not committed|Under a day|Under a week|Under a month|Under 6 months|Older", "what": "the age legend" },
    { "check": "getComputedStyle(document.querySelector('phitex-preview').shadowRoot.querySelector('.slot .bl-bar')).width", "page": true, "is": "3px", "what": "a bar 3 px wide" },
    { "shot": "blame-age-light" },
    { "pointer": ".slot .bl-bar", "nth": 4, "dx": 120 },
    { "check": "!document.querySelector('phitex-preview').shadowRoot.querySelector('.blcard').hidden && /v\\d+/.test(document.querySelector('phitex-preview').shadowRoot.querySelector('.blcard .meta').textContent) === false", "page": true, "what": "the card on hover: no hashes on Overleaf" },
    { "check": "[...document.querySelector('phitex-preview').shadowRoot.querySelectorAll('.blcard .acts button')].map((b) => b.textContent).join('|')", "page": true, "is": "Compare with before this version|Show in editor", "what": "the card's actions, in Overleaf's words" },
    { "check": "document.querySelector('phitex-preview').shadowRoot.querySelectorAll('.slot .bl-tint').length > 0", "page": true, "what": "the paragraph under the pointer tinted" },
    { "shot": "blame-card-light" },
    { "click": "#bl-mode button[data-v=author]" },
    { "click": "#bl-tint button[data-v=all]" },
    { "check": "[...document.querySelector('phitex-preview').shadowRoot.querySelectorAll('.blamebar .lg span:nth-child(2)')].map((e) => e.textContent).sort().join('|')", "page": true, "is": "Alice Martin|Bob Okabe|Carol Ito|Dana Reyes|Not committed", "what": "the authors, by their history names" },
    { "shot": "blame-author-light" },
    { "click": "#bl-mode button[data-v=since]" },
    { "click": "#bl-tint button[data-v=hover]" },
    { "check": "document.querySelector('phitex-preview').shadowRoot.querySelector('#bl-since option').textContent.startsWith('Submitted v1')", "page": true, "what": "since the label" },
    { "shot": "blame-since-light" },
    { "eval": "(() => { document.body.dataset.theme = 'default'; document.querySelector('phitex-preview').parentElement.classList.add('pdf-dark-mode'); return true; })()", "page": true }, { "wait": 1200 },
    { "shot": "blame-since-dark" },
    { "click": "#bl-mode button[data-v=author]" },
    { "shot": "blame-author-dark" },
    { "click": "#bl-mode button[data-v=age]" },
    { "shot": "blame-age-dark" },
    { "click": "#phitex-blame" },
    { "check": "document.querySelector('phitex-preview').shadowRoot.querySelectorAll('.slot .bl').length", "page": true, "is": 0, "what": "off: nothing over the pages" }
  ] }
