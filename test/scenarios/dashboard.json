{ "name": "dashboard", "dashboard": "test/scenarios/dashboard/projects.json", "strict": true, "nofirst": true,
  "storage": { "statusColumn": false, "foldersTipOff": true, "searchTipSeen": true },
  "steps": [
    { "settings": { "statusColumn": true } },
    { "what": "the top level: Recent, its 5 rows, Folders, the folder rows",
      "check": "[...document.querySelectorAll('.olf-rows > tr')].map((tr) => tr.classList.contains('olf-group') ? '#' + tr.textContent : tr.classList.contains('olf-recent-row') ? 'r' : tr.classList.contains('olf-folder-row') ? 'f' : '?')",
      "is": ["#Recent", "r", "r", "r", "r", "r", "#Folders", "f", "f"] },
    { "what": "the 5 edited last, newest first: no archived, trashed or storage project",
      "check": "[...document.querySelectorAll('.olf-rows tr.olf-recent-row td.dash-cell-name > a:first-child')].map((a) => [...a.childNodes].filter((n) => n.nodeType === 3).map((n) => n.textContent).join(''))",
      "is": ["Grail ISCA", "PhiTeX paper", "Lecture notes: Compilers", "CV", "Thesis proposal"] },
    { "what": "each one's folder (none at the top level)",
      "check": "[...document.querySelectorAll('.olf-rows tr.olf-recent-row')].map((tr) => tr.querySelector('.olf-path')?.dataset.path ?? '')",
      "is": ["Papers", "Papers › PhiTeX", "Teaching", "", "Papers"] },
    { "what": "owners and dates, as Overleaf's rows",
      "check": "[...document.querySelectorAll('.olf-rows tr.olf-recent-row')].map((tr) => tr.querySelector('td.dash-cell-owner').textContent + ', ' + tr.querySelector('td.dash-cell-date').textContent)",
      "is": ["You, 2 hours ago", "You, 5 hours ago", "Mohamed Bouaziz, yesterday", "You, 3 days ago", "You, 4 days ago"] },
    { "what": "each one's status, in the Status column",
      "check": "[...document.querySelectorAll('.olf-rows tr.olf-recent-row')].map((tr) => tr.querySelector('td.olf-status-cell .olf-status:not(.olf-status-empty)')?.textContent ?? '-')",
      "is": ["submitted", "drafting", "-", "-", "idea"] },
    { "what": "their cells in line with Overleaf's rows' (every column)",
      "check": "(() => { const x = (tr) => [...tr.children].map((td) => Math.round(td.getBoundingClientRect().left) + ':' + Math.round(td.getBoundingClientRect().width)); const r = document.querySelector('.olf-rows tr.olf-recent-row'), o = document.querySelector('#rows > tr[data-olf=show]'); return JSON.stringify(x(r)) === JSON.stringify(x(o)) || [x(r), x(o)]; })()" },
    { "what": "a link to the project, its clock where Overleaf's checkbox is",
      "check": "(() => { const tr = document.querySelector('.olf-rows tr.olf-recent-row'); return [tr.querySelector('td.dash-cell-name > a').getAttribute('href'), tr.querySelector('td.dash-cell-checkbox .material-symbols').textContent]; })()",
      "is": ["/project/6a0000000000000000000001", "history"] },
    { "shot": "top-light" },
    { "theme": "dark" }, { "wait": 300 }, { "shot": "top-dark" },
    { "width": 420 }, { "shot": "top-phone-dark" }, { "width": 0 },
    { "theme": "light" },
    { "search": "grail" },
    { "what": "searching: no Recent", "check": "document.querySelectorAll('.olf-rows tr.olf-recent-row, .olf-rows tr.olf-group').length", "is": 0 },
    { "shot": "search" },
    { "search": "" },
    { "what": "the search cleared: Recent again", "check": "document.querySelectorAll('.olf-rows tr.olf-recent-row').length", "is": 5 },
    { "click": ".olf-rows tr.olf-folder-row[data-folder=a1b2c3d4] .olf-folder-link" },
    { "what": "in a folder: no Recent, no headings", "check": "[document.querySelectorAll('.olf-rows tr.olf-recent-row, .olf-rows tr.olf-group').length, document.querySelectorAll('.olf-rows tr.olf-folder-row').length]", "is": [0, 1] },
    { "shot": "in-folder" },
    { "click": ".olf-crumbs a[href='/project']" },
    { "what": "back at the top level: Recent again", "check": "document.querySelectorAll('.olf-rows tr.olf-recent-row').length", "is": 5 },
    { "click": "#filters li:nth-child(2) > button" },
    { "what": "Overleaf's \"Your projects\": none of the folders' rows", "check": "getComputedStyle(document.querySelector('tbody.olf-rows')).display", "is": "none" },
    { "click": "#filters li:nth-child(1) > button" },
    { "drag": ".olf-rows tr.olf-recent-row[data-project='6a0000000000000000000004']", "to": ".olf-rows tr.olf-folder-row[data-folder=c3d4e5f6] td.dash-cell-name" },
    { "what": "a recent row dragged into a folder: filed there",
      "check": "document.querySelector(\".olf-rows tr.olf-recent-row[data-project='6a0000000000000000000004'] .olf-path\")?.dataset.path ?? 'none'", "is": "Teaching" },
    { "shot": "after-drag" }
  ] }
