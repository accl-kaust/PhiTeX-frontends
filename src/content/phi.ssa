%13 = %4()                                   ; \loop → "\ifnum\count1<3 \advance\count1 by 1 \loop\fi"
%14 = %6(%12, "<", %13:"3")                  ; true
%15 = %8(%12, %13:"1")                       ; \count1 = 3
%16 = %4()                                   ; \loop → "\ifnum\count1<3 \advance\count1 by 1 \loop\fi"
%17 = %6(%15, "<", %16:"3")                  ; false
%18 = %17(%16:"\advance\count1 by 1 \loop")  ; not taken
%19 = φ(%14, %15, %12)                       ; \count1 (then)
%20 = φ(%11, %19, %9)                        ; \count1 (then)
%21 = φ(%7, %20, %1)                         ; \count1 (then)
